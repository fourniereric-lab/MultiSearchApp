<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net10.0-android</TargetFramework>
	<OutputType>Exe</OutputType>
	<RootNamespace>MultiSearchApp.Android</RootNamespace>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<ApplicationTitle>MultiSearch</ApplicationTitle>
	<ApplicationId>com.multisearchapp.android</ApplicationId>
	<ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
	<ApplicationVersion>1</ApplicationVersion>
	<AndroidMinSdkVersion>23</AndroidMinSdkVersion>
	<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>
</Project>
