<Window
    x:Class="MultiSearchApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MultiSearchApp"
    Title="MultiSearch - Recherche Multi-Moteur">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE721;" FontSize="26" Foreground="White"/>
                    <TextBlock Text="MultiSearch" FontSize="20"
                               FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <Border Background="#33FFFFFF" CornerRadius="4"
                            Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.0" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Click="ThemeToggleButton_Click"
                            Background="Transparent"
                            BorderBrush="#66FFFFFF" Foreground="White"
                            Padding="10,8"
                            ToolTipService.ToolTip="Basculer thème clair/sombre">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE793;" FontSize="15"/>
                    </Button>

                    <Button x:Name="HistoryButton"
                            Click="HistoryButton_Click"
                            Background="Transparent"
                            BorderBrush="#66FFFFFF" Foreground="White"
                            Padding="10,8"
                            ToolTipService.ToolTip="Historique des recherches">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81C;" FontSize="15"/>
                            <TextBlock Text="Historique" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FavoritesButton"
                            Click="FavoritesButton_Click"
                            Background="Transparent"
                            BorderBrush="#66FFFFFF" Foreground="White"
                            Padding="10,8"
                            ToolTipService.ToolTip="Mes favoris">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE734;" FontSize="15"/>
                            <TextBlock Text="Favoris" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEARCH BAR -->
        <Border Grid.Row="1" Padding="20,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Entrez votre recherche et appuyez sur Entrée..."
                    QueryIcon="Find"
                    FontSize="15"
                    Height="42"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    TextChanged="SearchBox_TextChanged"/>

                <ComboBox x:Name="SafeSearchCombo"
                          Grid.Column="1" Height="42" MinWidth="160"
                          SelectedIndex="0"
                          ToolTipService.ToolTip="Niveau de filtre SafeSearch">
                    <ComboBoxItem Content="🛡 SafeSearch: Modéré"/>
                    <ComboBoxItem Content="🔒 SafeSearch: Strict"/>
                    <ComboBoxItem Content="🔓 SafeSearch: Désactivé"/>
                </ComboBox>

                <Button x:Name="FavoriteToggleButton"
                        Grid.Column="2" Height="42" Padding="16,0"
                        Click="FavoriteToggleButton_Click"
                        ToolTipService.ToolTip="Ajouter ou retirer des favoris">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="15"/>
                        <TextBlock x:Name="FavoriteToggleText" Text="Favori" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SearchButton"
                        Grid.Column="3" Height="42" Padding="20,0"
                        Click="SearchButton_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="15"/>
                        <TextBlock Text="Rechercher" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ENGINE SELECTOR -->
        <Border Grid.Row="2" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Moteurs :"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,12,0"/>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EnginePanel"
                                Orientation="Horizontal" Spacing="6"/>
                </ScrollViewer>

                <Button Grid.Column="2" x:Name="SelectAllButton"
                        Click="SelectAllButton_Click"
                        Padding="10,6" Margin="12,0,0,0"
                        ToolTipService.ToolTip="Tout sélectionner / désélectionner">
                    <FontIcon Glyph="&#xE762;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- RESULTS TABS -->
        <TabView x:Name="ResultsTabView"
                  Grid.Row="3"
                  MinHeight="500"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  TabWidthMode="SizeToContent"
                  AddTabButtonClick="ResultsTabView_AddTabButtonClick"
                  TabCloseRequested="ResultsTabView_TabCloseRequested"/>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Padding="16,5"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="StatusText"
                               Text="Prêt — Sélectionnez des moteurs et lancez une recherche"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="EngineCountText"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                               FontWeight="SemiBold"/>
                    <HyperlinkButton x:Name="ClearAllButton"
                                     Content="✕ Tout fermer"
                                     Click="ClearAllButton_Click"
                                     FontSize="12" Padding="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>